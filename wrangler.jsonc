{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logisticsworld",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "analytics_engine_datasets": [{ "binding": "REFERRALS", "dataset": "logisticsworld_referrals" }],
  "routes": [
    { "pattern": "logisticsworld.eu", "custom_domain": true },
    { "pattern": "www.logisticsworld.eu", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
