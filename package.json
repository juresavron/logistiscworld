{
  "name": "logisticsworld",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "node scripts/clean-build.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "npm run build:node && node scripts/smoke.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "build:node": "node scripts/clean-build.mjs && vite build --mode node-smoke"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "lucide-react": "0.575.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@tailwindcss/vite": "4.2.1",
    "@types/node": "22.16.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.8.3",
    "vite": "7.3.1",
    "vitest": "4.1.5",
    "wrangler": "4.149.0"
  }
}
